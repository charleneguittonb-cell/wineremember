# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used to read labels, research wines and suggest similar ones
CLAUDE_MODEL=claude-opus-5-5

# Folder where the SQLite database and photos are stored
DATA_DIR=./data

# Set to 1 to try the app without an API key (returns a sample label)
VISION_MOCK=0
